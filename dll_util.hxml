-cp source
--macro haxe.macro.HashAbi.enable()
--macro haxe.macro.abi.LuaOutput.enable()
-dce full
-D lua-vanilla
-D analyzer-optimize
-D lua-ver=5.4
--macro haxe.macro.abi.Chunks.select("dll_util")
-main lua.abi.DllUtil
-lua build/dll_util.lua
--macro keep('Array')
--macro keep('String')
--macro keep('haxe.Exception')
--macro keep('haxe.NativeStackTrace')
--macro keep('haxe.ValueException')
--macro keep('haxe.exceptions.PosException')
--macro keep('haxe.exceptions.NotImplementedException')
--macro keep('haxe.iterators.ArrayIterator')
--macro keep('haxe.iterators.ArrayKeyValueIterator')
